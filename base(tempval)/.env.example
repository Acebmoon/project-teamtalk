# Copie para .env.local (ignorado pelo Git). Nunca cole credenciais em issues/logs.
# Em homologação, configure Preview no painel Vercel; use HTTPS e um Supabase separado.
# Veja docs/homologacao-vercel-supabase.md. Obtenha valores locais em supabase status.
# Únicas variáveis da aplicação destinadas ao navegador: URL e chave anon/publishable.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=substitua-pela-chave-local
# Duração absoluta por aparelho, em horas, a partir do login por senha (JWT amr).
SESSAO_MAX_HORAS=12

# Opcionais na main; necessários ao integrar os PRs #100/#102/#103/#106.
# service_role/secret é EXCLUSIVA do servidor. Nunca adicionar NEXT_PUBLIC_ a segredos.
# Deixe vazia até configurar um recurso que exija essa chave.
SUPABASE_SERVICE_ROLE_KEY=
# PR #102: default do serviço é 10 MiB, mas a Vercel limita payload a 4,5 MB.
# 4.000.000 bytes deixam margem para multipart. Usar o mesmo limite no seletor #104.
PDF_MAX_BYTES=4000000

# PR #103: disabled não envia e-mail; cadastro/reset falham com 503 antes de mutações.
# Para habilitar: resend + remetente individual verificado + chave privada + URL HTTPS.
EMAIL_PROVIDER=disabled
EMAIL_FROM=
EMAIL_API_KEY=
TEAMTALK_PUBLIC_URL=
# Inteiro de 1 a 168 horas; prazo padrão de 24h contado no banco.
CREDENCIAL_INICIAL_VALIDADE_HORAS=24
