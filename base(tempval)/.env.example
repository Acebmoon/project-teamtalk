# Copie para .env.local; obtenha a chave pública em npx supabase status.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=substitua-pela-chave-local
# Duração absoluta por aparelho, em horas, a partir do login por senha (JWT amr).
SESSAO_MAX_HORAS=12
# Somente no servidor: Storage privado; nunca usar prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=substitua-pela-chave-service-role-local
# Limite real do arquivo em bytes (padrão: 10 MiB); não inclui overhead multipart.
PDF_MAX_BYTES=10485760
